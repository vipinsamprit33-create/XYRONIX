
# ============================================================
# NUNVIZHI - SMART CAMPUS ENERGY & TRAFFIC INTELLIGENCE
# Complete Jupyter Notebook
# ============================================================

import io
import gzip
import zipfile
from pathlib import Path

import pandas as pd
import matplotlib.pyplot as plt
from IPython.display import display

# ------------------------------------------------------------
# STEP 1: FIND PROJECT DIRECTORY
# ------------------------------------------------------------

current_dir = Path.cwd()

if (current_dir / "hourly load profile of NITPY.xlsx").exists():
    BASE_DIR = current_dir
elif (current_dir.parent / "hourly load profile of NITPY.xlsx").exists():
    BASE_DIR = current_dir.parent
else:
    BASE_DIR = Path(r"D:\CampusOptimizer")

ENERGY_FILE = BASE_DIR / "hourly load profile of NITPY.xlsx"
TRAFFIC_FILE = BASE_DIR / "metro+interstate+traffic+volume.zip"

print("=" * 60)
print("NUNVIZHI - AI CAMPUS INTELLIGENCE")
print("=" * 60)
print("Project directory:", BASE_DIR)

# ------------------------------------------------------------
# STEP 2: LOAD ENERGY DATASET
# ------------------------------------------------------------

print("\n[1] LOADING ENERGY DATASET")

if not ENERGY_FILE.exists():
    raise FileNotFoundError(
        f"Energy dataset not found: {ENERGY_FILE}"
    )

energy = pd.read_excel(
    ENERGY_FILE,
    sheet_name="Sheet1",
    header=None
)

energy = pd.DataFrame({
    "load": pd.to_numeric(
        energy.iloc[:, 0],
        errors="coerce"
    )
})

print("Total energy rows:", len(energy))
print("Valid readings:", energy["load"].count())
print("Missing readings:", energy["load"].isna().sum())

display(energy.head(10))

# ------------------------------------------------------------
# STEP 3: ENERGY STATISTICAL ANALYSIS
# ------------------------------------------------------------

print("\n[2] ENERGY STATISTICAL ANALYSIS")

energy_stats = {
    "Total Readings": len(energy),
    "Average Load": round(energy["load"].mean(), 2),
    "Minimum Load": round(energy["load"].min(), 2),
    "Maximum Load": round(energy["load"].max(), 2),
    "Median Load": round(energy["load"].median(), 2),
    "Standard Deviation": round(energy["load"].std(), 2)
}

display(
    pd.DataFrame(
        energy_stats.items(),
        columns=["Metric", "Value"]
    )
)

# ------------------------------------------------------------
# STEP 4: ENERGY LOAD VISUALIZATION
# ------------------------------------------------------------

print("\n[3] ENERGY LOAD VISUALIZATION")

plt.figure(figsize=(13, 5))

plt.plot(
    energy["load"].iloc[:168],
    linewidth=1.5,
    label="Load"
)

plt.title("NUNVIZHI - First 168 Energy Readings")
plt.xlabel("Reading Index")
plt.ylabel("Load (Unit Not Verified)")
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()

# ------------------------------------------------------------
# STEP 5: ENERGY LOAD DISTRIBUTION
# ------------------------------------------------------------

plt.figure(figsize=(10, 5))

plt.hist(
    energy["load"].dropna(),
    bins=30,
    edgecolor="black"
)

plt.title("Energy Load Distribution")
plt.xlabel("Load (Unit Not Verified)")
plt.ylabel("Frequency")
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

# ------------------------------------------------------------
# STEP 6: LOAD TRAFFIC DATASET
# ------------------------------------------------------------

print("\n[4] LOADING TRAFFIC DATASET")

if not TRAFFIC_FILE.exists():
    raise FileNotFoundError(
        f"Traffic dataset not found: {TRAFFIC_FILE}"
    )

with zipfile.ZipFile(TRAFFIC_FILE) as archive:

    csv_files = [
        name for name in archive.namelist()
        if name.lower().endswith((".csv", ".csv.gz"))
    ]

    if not csv_files:
        raise ValueError("No CSV file found inside ZIP.")

    filename = csv_files[0]
    raw_data = archive.read(filename)

    if filename.lower().endswith(".gz"):
        raw_data = gzip.decompress(raw_data)

traffic = pd.read_csv(io.BytesIO(raw_data))

traffic["traffic_volume"] = pd.to_numeric(
    traffic["traffic_volume"],
    errors="coerce"
)

traffic["date_time"] = pd.to_datetime(
    traffic["date_time"],
    errors="coerce"
)

traffic["hour"] = traffic["date_time"].dt.hour

print("Total traffic records:", len(traffic))
print("Dataset type: Historical interstate traffic")
display(traffic.head(10))

# ------------------------------------------------------------
# STEP 7: TRAFFIC STATISTICAL ANALYSIS
# ------------------------------------------------------------

print("\n[5] TRAFFIC STATISTICAL ANALYSIS")

traffic_stats = {
    "Total Records": len(traffic),
    "Average Traffic Volume": round(
        traffic["traffic_volume"].mean(), 2
    ),
    "Maximum Traffic Volume": traffic["traffic_volume"].max(),
    "Minimum Traffic Volume": traffic["traffic_volume"].min()
}

display(
    pd.DataFrame(
        traffic_stats.items(),
        columns=["Metric", "Value"]
    )
)

# ------------------------------------------------------------
# STEP 8: HOURLY TRAFFIC ANALYSIS
# ------------------------------------------------------------

hourly_traffic = (
    traffic.groupby("hour")["traffic_volume"]
    .mean()
    .sort_index()
)

peak_hour = int(hourly_traffic.idxmax())

print("Peak traffic hour:", peak_hour)

plt.figure(figsize=(12, 5))

plt.bar(
    hourly_traffic.index,
    hourly_traffic.values
)

plt.title("Average Historical Interstate Traffic by Hour")
plt.xlabel("Hour of Day")
plt.ylabel("Average Traffic Volume")
plt.xticks(range(24))
plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()

# ------------------------------------------------------------
# STEP 9: TRAFFIC TREND VISUALIZATION
# ------------------------------------------------------------

plt.figure(figsize=(13, 5))

plt.plot(
    traffic["traffic_volume"].iloc[:500].to_numpy(),
    linewidth=1
)

plt.title("First 500 Historical Traffic Observations")
plt.xlabel("Observation Index")
plt.ylabel("Traffic Volume")
plt.grid(True)
plt.tight_layout()
plt.show()

# ------------------------------------------------------------
# STEP 10: DATA QUALITY AGENT
# ------------------------------------------------------------

print("\n[6] DATA QUALITY AGENT")

data_quality = {
    "Energy Rows": len(energy),
    "Energy Missing Values": int(
        energy["load"].isna().sum()
    ),
    "Traffic Rows": len(traffic),
    "Traffic Missing Volume Values": int(
        traffic["traffic_volume"].isna().sum()
    ),
    "Energy Units Verified": False,
    "Energy Timestamps Verified": False,
    "Campus Traffic Verified": False
}

display(
    pd.DataFrame(
        data_quality.items(),
        columns=["Check", "Result"]
    )
)

# ------------------------------------------------------------
# STEP 11: ENERGY ANALYST AGENT
# ------------------------------------------------------------

print("\n[7] ENERGY ANALYST AGENT")

average_load = float(energy["load"].mean())
maximum_load = float(energy["load"].max())

if maximum_load > average_load * 1.5:
    energy_recommendation = (
        "Significant variation exists between average "
        "and maximum load. Investigate high-load periods "
        "before proposing optimization measures."
    )
else:
    energy_recommendation = (
        "Load variation is comparatively moderate "
        "under this simple rule."
    )

print("Average load:", round(average_load, 2))
print("Maximum load:", round(maximum_load, 2))
print("Recommendation:", energy_recommendation)

# ------------------------------------------------------------
# STEP 12: TRAFFIC ANALYST AGENT
# ------------------------------------------------------------

print("\n[8] TRAFFIC ANALYST AGENT")

traffic_recommendation = (
    f"The historical interstate dataset has its "
    f"highest average traffic volume at {peak_hour}:00. "
    "This is not evidence of campus traffic patterns. "
    "Collect campus-specific observations before "
    "making operational decisions."
)

print(traffic_recommendation)

# ------------------------------------------------------------
# STEP 13: AI-READY SUMMARY
# ------------------------------------------------------------

print("\n[9] NUNVIZHI INTELLIGENCE SUMMARY")

summary = {
    "Project": "NUNVIZHI",
    "Energy Readings": len(energy),
    "Average Load": round(average_load, 2),
    "Maximum Load": round(maximum_load, 2),
    "Traffic Records": len(traffic),
    "Average Traffic Volume": round(
        traffic["traffic_volume"].mean(), 2
    ),
    "Peak Interstate Traffic Hour": peak_hour,
    "Energy Recommendation": energy_recommendation,
    "Traffic Recommendation": traffic_recommendation,
    "Data Limitations": (
        "Energy units and timestamps are unverified. "
        "Traffic data is historical interstate data, "
        "not campus-specific data."
    )
}

display(
    pd.DataFrame(
        summary.items(),
        columns=["Parameter", "Result"]
    )
)

# ------------------------------------------------------------
# STEP 14: EXPORT ANALYSIS REPORT
# ------------------------------------------------------------

report_file = BASE_DIR / "nunvizhi_notebook_report.txt"

with open(report_file, "w", encoding="utf-8") as file:
    file.write("NUNVIZHI - NOTEBOOK ANALYSIS REPORT\n")
    file.write("=" * 50 + "\n\n")

    for key, value in summary.items():
        file.write(f"{key}: {value}\n")

print("\nReport saved to:", report_file)

print("\n" + "=" * 60)
print("NUNVIZHI NOTEBOOK EXECUTION COMPLETED")
print("=" * 60)
